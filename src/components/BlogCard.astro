---
import type { BlogPost } from '../utils/content';
import { formatDate, readingTime, tagSlug, withBase } from '../utils/content';

interface Props { post: BlogPost; }
const { post } = Astro.props;
---

<article class="blog-card">
  <p class="meta">{formatDate(post.data.publishedDate)} · {readingTime(post.body)}</p>
  <h2><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
  <p class="description">{post.data.description}</p>
  <div class="tags">
    {post.data.tags.map((tag) => <a class="tag" href={withBase(`/blog/tags/${tagSlug(tag)}/`)}>{tag}</a>)}
  </div>
</article>

<style>
  .blog-card { padding: 32px 0; border-top: 1px solid var(--border); }
  .blog-card h2 { max-width: 760px; margin: 14px 0 10px; font-size: clamp(1.45rem, 3vw, 2.15rem); font-weight: 560; letter-spacing: -0.03em; line-height: 1.22; }
  .blog-card h2 a:hover { color: var(--accent); }
  .description { max-width: 700px; margin: 0 0 22px; color: var(--muted); }
  .tag:hover { border-color: var(--accent); color: var(--accent); }
</style>
