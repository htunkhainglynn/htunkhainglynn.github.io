---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteData } from '../data/site';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
import { formatDate, publishedPosts, readingTime, withBase } from '../utils/content';

const posts = publishedPosts(await getCollection('blog')).slice(0, 2);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 2);
const homeURL = new URL(Astro.url.pathname, Astro.site).href;
const personId = `${homeURL}#person`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeURL}#website`,
      url: homeURL,
      name: siteData.name,
      description: siteData.description,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${homeURL}#profile-page`,
      url: homeURL,
      name: `${siteData.name} — Platform Developer`,
      description: siteData.description,
      inLanguage: 'en',
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: siteData.name,
      description: siteData.description,
      url: homeURL,
      email: `mailto:${siteData.email}`,
      jobTitle: siteData.role,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Yangon',
        addressCountry: 'MM',
      },
      worksFor: {
        '@type': 'Organization',
        name: siteData.company,
        url: siteData.companyUrl,
      },
      sameAs: [siteData.linkedin, siteData.github],
      knowsAbout: [
        'Java',
        'Spring Boot',
        'Backend development',
        'Financial technology',
        'Payment systems',
        'Distributed systems',
      ],
    },
  ],
};
---

<BaseLayout structuredData={structuredData}>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Platform Developer at Wave Money · Yangon, Myanmar</p>
      <h1>{siteData.name}</h1>
      <p class="hero-intro">
        Hey, I’m Htun! I build secure Java and Spring Boot systems for financial services—especially
        cross-border payments, bank integrations, and transaction flows people can count on.
      </p>
      <div class="hero-actions">
        <a class="button" href={withBase('/projects/')}>View projects <span aria-hidden="true">→</span></a>
        <a class="button secondary" href={withBase('/blog/')}>Read my blog</a>
      </div>
      <div class="hero-links" aria-label="Professional profiles">
        <a href={siteData.github} rel="me noreferrer" target="_blank">GitHub ↗</a>
        <a href={siteData.linkedin} rel="me noreferrer" target="_blank">LinkedIn ↗</a>
      </div>
    </div>
    <aside class="hero-note" aria-label="Engineering focus">
      <p class="note-label">Current focus</p>
      <ul>
        <li><span>01</span> Financial platforms</li>
        <li><span>02</span> Cross-border payments</li>
        <li><span>03</span> Bank integrations</li>
        <li><span>04</span> Reliable transaction flows</li>
      </ul>
      <div class="availability"><span></span> Always happy to swap ideas about backend engineering</div>
    </aside>
  </section>

  <section class="principles container" aria-labelledby="principles-heading">
    <div>
      <p class="eyebrow">How I work</p>
      <h2 id="principles-heading" class="section-heading">Serious about systems.<br />Easy to talk to.</h2>
    </div>
    <div class="principle-grid">
      <article>
        <span class="principle-number">01</span>
        <h3>Plan for the weird days</h3>
        <p>I like designs that stay calm when a dependency slows down, a message arrives twice, or only half the work succeeds.</p>
      </article>
      <article>
        <span class="principle-number">02</span>
        <h3>Keep it easy to follow</h3>
        <p>Good code should help the next person understand the important rules without needing a treasure map.</p>
      </article>
      <article>
        <span class="principle-number">03</span>
        <h3>Watch what actually happens</h3>
        <p>Logs, metrics, and traces belong in the plan from day one. Production always has something useful to teach us.</p>
      </article>
    </div>
  </section>

  <section class="work container" aria-labelledby="work-heading">
    <div class="section-topline">
      <div><p class="eyebrow">Selected work</p><h2 id="work-heading" class="section-heading">Engineering projects</h2></div>
      <a class="text-link" href={withBase('/projects/')}>All projects →</a>
    </div>
    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <article class="project-row">
          <span class="project-index">0{index + 1}</span>
          <div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
          <div class="tags">{project.technologies.slice(0, 4).map((technology) => <span class="tag">{technology}</span>)}</div>
          {project.demo && <a href={project.demo} rel="noreferrer" target="_blank" aria-label={`View ${project.name} details`}>{project.demoLabel ?? 'Details'} ↗</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="writing container" aria-labelledby="writing-heading">
    <div class="section-topline">
      <div><p class="eyebrow">From the notebook</p><h2 id="writing-heading" class="section-heading">Recent writing</h2></div>
      <a class="text-link" href={withBase('/blog/')}>Browse the blog →</a>
    </div>
    <div class="post-list">
      {posts.map((post) => (
        <article>
          <p class="meta">{formatDate(post.data.publishedDate)} · {readingTime(post.body)}</p>
          <h3><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="contact container">
    <p class="eyebrow">Get in touch</p>
    <h2>Got a backend puzzle,<br />a project idea, or a good tech story?</h2>
    <a class="text-link" href={withBase('/contact/')}>Come say hello →</a>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 90px; align-items: end; min-height: 690px; padding-block: 120px 90px; }
  .hero h1 { max-width: 700px; margin: 0; font-size: clamp(3.7rem, 9vw, 8rem); font-weight: 560; letter-spacing: -0.07em; line-height: 0.86; }
  .hero-intro { max-width: 650px; margin: 36px 0 0; color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
  .hero-links { display: flex; gap: 20px; margin-top: 24px; }
  .hero-links a { color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; }
  .hero-links a:hover { color: var(--accent); }
  .hero-note { padding: 24px 0 4px 26px; border-left: 1px solid var(--border); }
  .note-label { margin: 0 0 18px; color: var(--faint); font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .hero-note ul { padding: 0; margin: 0; list-style: none; }
  .hero-note li { display: flex; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
  .hero-note li span { color: var(--faint); font-family: var(--font-mono); font-size: 0.7rem; }
  .availability { display: flex; gap: 9px; align-items: center; margin-top: 24px; color: var(--muted); font-size: 0.72rem; }
  .availability span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .principles, .work, .writing { padding-block: 105px; border-top: 1px solid var(--border); }
  .principles { display: grid; grid-template-columns: 0.72fr 1.6fr; gap: 90px; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 38px; }
  .principle-number, .project-index { color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; }
  .principle-grid h3 { margin: 36px 0 12px; font-size: 1rem; font-weight: 650; }
  .principle-grid p, .project-row p, .post-list p { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .section-topline { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 46px; }
  .section-topline .eyebrow { margin-bottom: 14px; }
  .project-list { border-top: 1px solid var(--border); }
  .project-row { display: grid; grid-template-columns: 44px 1.2fr 0.8fr auto; gap: 26px; align-items: start; padding: 30px 0; border-bottom: 1px solid var(--border); }
  .project-row h3 { margin: 0 0 8px; font-size: 1.15rem; font-weight: 600; }
  .project-row > a { color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; }
  .project-row > a:hover { color: var(--accent); }
  .post-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 60px; }
  .post-list article { padding-top: 25px; border-top: 1px solid var(--border); }
  .post-list h3 { margin: 18px 0 12px; font-size: clamp(1.35rem, 2vw, 1.7rem); font-weight: 560; line-height: 1.3; letter-spacing: -0.02em; }
  .post-list h3 a:hover { color: var(--accent); }
  .post-list .tags { margin-top: 22px; }
  .contact { padding: 100px 0 20px; border-top: 1px solid var(--border); }
  .contact h2 { margin: 0 0 32px; font-size: clamp(2rem, 5.4vw, 4.6rem); font-weight: 540; letter-spacing: -0.05em; line-height: 1.08; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 55px; min-height: auto; padding-block: 100px 70px; }
    .hero-note { max-width: 480px; }
    .principles { grid-template-columns: 1fr; gap: 55px; }
    .project-row { grid-template-columns: 36px 1fr auto; }
    .project-row .tags { grid-column: 2 / -1; }
  }
  @media (max-width: 640px) {
    .hero { padding-block: 80px 60px; }
    .principles, .work, .writing { padding-block: 75px; }
    .principle-grid, .post-list { grid-template-columns: 1fr; gap: 42px; }
    .principle-grid h3 { margin-top: 16px; }
    .section-topline { align-items: start; flex-direction: column; }
    .project-row { grid-template-columns: 30px 1fr; }
    .project-row > a { grid-column: 2; }
    .project-row .tags { grid-column: 2; }
    .contact br { display: none; }
  }
</style>
