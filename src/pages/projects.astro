---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects" description="Software engineering projects with technical decisions, constraints, and lessons learned.">
  <PageHeader
    eyebrow="Projects"
    title="Problems explored through working software."
    intro="These projects focus on the decisions behind a system: its failure modes, data boundaries, operational behavior, and the tradeoffs made along the way."
  />

  <section class="project-grid container" aria-label="Engineering projects">
    {projects.map((project, index) => (
      <article class:list={['project', { featured: project.featured }]}>
        <header>
          <div class="project-label"><span>0{index + 1}</span>{project.featured && <strong>Featured</strong>}</div>
          <h2>{project.name}</h2>
          <p>{project.description}</p>
        </header>
        <div class="project-body">
          <h3>Engineering challenges</h3>
          <ul>{project.challenges.map((challenge) => <li>{challenge}</li>)}</ul>
        </div>
        <footer>
          <div class="tags">{project.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
          <div class="project-links">
            <a href={project.repository} rel="noreferrer" target="_blank">Repository ↗</a>
            {project.demo && <a href={project.demo} rel="noreferrer" target="_blank">Live demo ↗</a>}
          </div>
        </footer>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .project { display: flex; min-height: 560px; flex-direction: column; justify-content: space-between; padding: 38px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .project.featured { background: var(--surface); }
  .project-label { display: flex; justify-content: space-between; color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .project-label strong { font-weight: 600; }
  .project h2 { margin: 72px 0 16px; font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 560; letter-spacing: -0.045em; line-height: 1.05; }
  .project header > p { max-width: 550px; margin: 0; color: var(--muted); }
  .project-body { margin-block: 52px; }
  .project-body h3 { margin: 0 0 12px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .project-body ul { padding: 0; margin: 0; list-style: none; }
  .project-body li { position: relative; margin: 9px 0; padding-left: 18px; color: var(--muted); font-size: 0.88rem; }
  .project-body li::before { position: absolute; left: 0; content: '—'; color: var(--accent); }
  .project footer { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-top: 24px; border-top: 1px solid var(--border); }
  .project-links { display: flex; flex: none; gap: 16px; font-family: var(--font-mono); font-size: 0.72rem; }
  .project-links a:hover { color: var(--accent); }
  @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } .project { min-height: 500px; padding: 28px; } .project footer { align-items: start; flex-direction: column; } }
</style>
