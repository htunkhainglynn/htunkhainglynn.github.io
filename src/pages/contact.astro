---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { siteData } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Contact ${siteData.name}, a software engineer in Yangon who loves talking about backend systems, friendly APIs, fintech projects, and engineering opportunities.`}
>
  <PageHeader
    eyebrow="Drop a line"
    title="Good ideas are better when shared."
    intro="Bring a backend puzzle, a fintech project, an engineering opportunity, or a thought sparked by the blog. My inbox is always happy to make a new friend."
  />

  <section class="contact-layout container">
    <div class="mailbox" aria-labelledby="message-heading">
      <div class="mailbox-header">
        <div>
          <p class="mailbox-label">New message</p>
          <h2 id="message-heading">Start a good conversation</h2>
        </div>
        <span class="mail-mark" aria-hidden="true">@</span>
      </div>

      <form id="contact-form" data-recipient={siteData.email}>
        <div class="field-row">
          <label>
            <span>Your name</span>
            <input type="text" name="name" autocomplete="name" required placeholder="How should I address you?" />
          </label>
          <label>
            <span>Your email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          </label>
        </div>

        <label>
          <span>Subject</span>
          <input type="text" name="subject" required placeholder="What would you like to discuss?" />
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" rows="8" required placeholder="Share a little context…"></textarea>
        </label>

        <div class="form-footer">
          <p>This opens your usual email app—no mystery database, no vanishing message.</p>
          <button class="button" type="submit">Send it my way <span aria-hidden="true">→</span></button>
        </div>
      </form>
    </div>

    <aside class="contact-aside">
      <div>
        <p class="eyebrow">Direct email</p>
        <a class="direct-email" href={`mailto:${siteData.email}`}>{siteData.email}</a>
      </div>

      <div class="contact-details">
        <div><span>Based in</span><strong>{siteData.location}</strong></div>
        <div><span>What I do</span><strong>Software engineering · Backend systems · APIs</strong></div>
        <div><span>Good topics</span><strong>Java, Spring Boot, fintech, curious ideas</strong></div>
      </div>

      <div class="profile-links">
        <a href={siteData.linkedin} rel="me noreferrer" target="_blank">LinkedIn ↗</a>
        <a href={siteData.github} rel="me noreferrer" target="_blank">GitHub ↗</a>
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const recipient = form.dataset.recipient ?? '';
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const subject = String(data.get('subject') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const body = `Hi Htun Khaing Lynn,\n\n${message}\n\nFrom: ${name} <${email}>`;

    window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(270px, 0.55fr); gap: 70px; align-items: start; }
  .mailbox { border: 1px solid var(--border); background: var(--surface); }
  .mailbox-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 28px 32px; border-bottom: 1px solid var(--border); }
  .mailbox-label { margin: 0 0 4px; color: var(--accent); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  .mailbox-header h2 { margin: 0; font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; }
  .mail-mark { display: grid; width: 42px; height: 42px; flex: 0 0 auto; place-items: center; border: 1px solid var(--border); border-radius: 50%; color: var(--accent); font-family: var(--font-mono); font-size: 1rem; font-weight: 700; }
  form { display: grid; gap: 24px; padding: 32px; }
  .field-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  label { display: grid; gap: 8px; }
  label > span { color: var(--muted); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  input, textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: 3px; background: var(--background); color: var(--text); font: inherit; transition: border-color 160ms ease, background 160ms ease; }
  input { min-height: 46px; }
  textarea { resize: vertical; line-height: 1.6; }
  input::placeholder, textarea::placeholder { color: var(--faint); }
  input:hover, textarea:hover { border-color: var(--faint); }
  input:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }
  .form-footer { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding-top: 8px; }
  .form-footer p { max-width: 330px; margin: 0; color: var(--faint); font-size: 0.75rem; }
  .form-footer .button { flex: 0 0 auto; cursor: pointer; }
  .contact-aside { display: grid; gap: 38px; padding: 28px 0 0; }
  .contact-aside .eyebrow { margin-bottom: 10px; }
  .direct-email { font-size: 0.92rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 5px; }
  .direct-email:hover { color: var(--accent); text-decoration-color: var(--accent); }
  .contact-details { border-top: 1px solid var(--border); }
  .contact-details div { display: grid; gap: 3px; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .contact-details span { color: var(--faint); font-family: var(--font-mono); font-size: 0.67rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .contact-details strong { font-size: 0.84rem; font-weight: 560; line-height: 1.5; }
  .profile-links { display: flex; gap: 20px; }
  .profile-links a { color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; }
  .profile-links a:hover { color: var(--accent); }
  @media (max-width: 850px) { .contact-layout { grid-template-columns: 1fr; gap: 48px; } .contact-aside { grid-template-columns: repeat(2, 1fr); } .contact-details { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .mailbox-header, form { padding: 22px; } .field-row { grid-template-columns: 1fr; } .form-footer { align-items: stretch; flex-direction: column; } .contact-aside { grid-template-columns: 1fr; } .contact-details { grid-column: auto; } }
</style>
