---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { experiences } from '../data/experience';
---

<BaseLayout title="Experience" description="Professional software engineering experience, responsibilities, and technical impact.">
  <PageHeader
    eyebrow="Experience"
    title="Building dependable software, one constraint at a time."
    intro="A record of the systems I have contributed to, the responsibilities I have taken on, and the engineering practices I value."
  />

  <section class="timeline container" aria-label="Professional experience">
    {experiences.map((experience, index) => (
      <article class="role">
        <div class="marker" aria-hidden="true"><span></span></div>
        <div class="role-meta">
          <p class="company">{experience.company}</p>
          <p class="meta">{experience.period}</p>
        </div>
        <div class="role-detail">
          <p class="role-number">0{index + 1}</p>
          <h2>{experience.position}</h2>
          <p class="description">{experience.description}</p>
          <h3>Selected impact</h3>
          <ul>{experience.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
          <div class="tags">{experience.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .timeline { border-top: 1px solid var(--border); }
  .role { display: grid; grid-template-columns: 30px 0.62fr 1.4fr; gap: 36px; position: relative; padding: 58px 0 70px; border-bottom: 1px solid var(--border); }
  .marker { position: relative; }
  .marker::before { position: absolute; top: -58px; bottom: -70px; left: 5px; width: 1px; content: ''; background: var(--border); }
  .marker span { position: relative; z-index: 1; display: block; width: 11px; height: 11px; border: 2px solid var(--accent); border-radius: 50%; background: var(--background); }
  .company { margin: 0 0 5px; font-weight: 650; }
  .role-number { margin: 0 0 6px; color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; }
  .role h2 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.8rem); font-weight: 560; letter-spacing: -0.04em; }
  .description { max-width: 680px; margin: 18px 0 32px; color: var(--muted); font-size: 1.05rem; }
  .role h3 { margin: 0 0 12px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .role ul { padding: 0; margin: 0 0 28px; list-style: none; }
  .role li { position: relative; max-width: 680px; margin: 9px 0; padding-left: 19px; color: var(--muted); }
  .role li::before { position: absolute; left: 0; content: '—'; color: var(--accent); }
  @media (max-width: 760px) { .role { grid-template-columns: 20px 1fr; gap: 20px; } .role-meta, .role-detail { grid-column: 2; } .marker { grid-row: 1 / 3; } .marker::before { left: 4px; } }
</style>
